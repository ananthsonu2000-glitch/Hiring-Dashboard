# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-lite-latest

# Email — sent via Gmail SMTP (works for any Gmail or Google Workspace
# address, e.g. a custom-domain school/company email hosted on Google).
# EMAIL_APP_PASSWORD is a Google Account App Password, not your login
# password: myaccount.google.com/apppasswords (requires 2-Step Verification).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Optional — used in generated candidate emails
COMPANY_NAME=Kargo
